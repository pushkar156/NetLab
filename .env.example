# NetLab Environment Configuration Example

# Server Configuration
PORT=5000
HOST=0.0.0.0
NODE_ENV=development

# Database path (relative to server directory or absolute path)
DB_PATH=./data/netlab.db

# Frontend Client Configuration (for Vite)
# If connecting from another physical device on the same Wi-Fi, 
# set VITE_API_URL to your laptop's LAN IP, e.g., http://192.168.1.3:5000
VITE_API_URL=http://localhost:5000
VITE_SOCKET_URL=http://localhost:5000

# Firebase Configuration (for Authentication & Cloud Firestore)
# Create a free project at https://console.firebase.google.com/
# Add a Web App in Project Settings and paste the keys below:
VITE_FIREBASE_API_KEY=YOUR_FIREBASE_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
VITE_FIREBASE_APP_ID=your-app-id
